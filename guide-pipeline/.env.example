# --- Data sources (v1) ---
# NCBI E-utilities key (free): https://www.ncbi.nlm.nih.gov/account/ -> Settings -> API Key Management
NCBI_API_KEY=
NCBI_EMAIL=you@example.com
NCBI_TOOL=symposed-guide-pipeline

# --- LLM: Claude Sonnet 5 for every task, reasoning effort set per task ---
# Key: platform.claude.com -> API keys (billed separately from a Claude subscription)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# Per-task overrides, e.g. to try a stronger model for candidate titles only:
# MODEL_CANDIDATE_GENERATION=claude-fable-5-1
# EFFORT_CANDIDATE_GENERATION=xhigh      (low | medium | high | xhigh | max)
# THINKING_ATTRIBUTE_EXTRACTION=false
# Groq (free) is still selectable for local trials: LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.4

# --- Optional overrides (Step 3 gate thresholds are settings, not hardcoded) ---
# MIN_ELIGIBLE_STUDIES=8
# SCOPING_MIN_STUDIES=5
# MAX_RECORDS_TO_SCREEN=400
# RECENT_REVIEW_YEARS=4
# ACTIVE_TRIAL_COMPLETION_MONTHS=12
# CANDIDATE_TITLES_MIN=8
# CANDIDATE_TITLES_MAX=12
# LANDSCAPE_YEARS=10
# OUTPUT_DIR=output

# --- PROSPERO mirror (local SQLite copy of the register) ---
# PROSPERO_DB=data/prospero.sqlite
# PROSPERO_MAX_AGE_DAYS=10
# PROSPERO_MIN_INTERVAL=3.0
# PROSPERO_REJECT_SIMILARITY=0.75
# PROSPERO_REVIEW_SIMILARITY=0.45
