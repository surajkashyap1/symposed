# --- Data sources (v1) ---
# NCBI E-utilities key (free): https://www.ncbi.nlm.nih.gov/account/ -> Settings -> API Key Management
NCBI_API_KEY=
NCBI_EMAIL=you@example.com
NCBI_TOOL=symposed-guide-pipeline
# Optional contact for OpenAlex and Crossref polite pools (not the NCBI email)
# CONTACT_EMAIL=

# --- LLM: Claude Sonnet 5 for every task, reasoning effort set per task ---
# Key: platform.claude.com -> API keys (billed separately from a Claude subscription)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5           # the reader
# ANTHROPIC_DECISION_MODEL=claude-opus-5-5     # the decider (topics, gaps, final check)
# DISCOVERY_MODE=reviews                      # or axes (v1)
# PICK_BEFORE_GUIDE=true                     # stop with a top 3 shortlist until `pick`
# MAX_FULLTEXTS=6
# LLM_FALLBACKS=true
# Per-task overrides, e.g. to try a stronger model for candidate titles only:
# MODEL_CANDIDATE_GENERATION=claude-fable-5-1
# EFFORT_CANDIDATE_GENERATION=xhigh      (low | medium | high | xhigh | max)
# THINKING_ATTRIBUTE_EXTRACTION=false
# Groq (free) is still selectable for local trials: LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.4

# --- Optional overrides (Step 3 gate thresholds are settings, not hardcoded) ---
# MIN_ELIGIBLE_STUDIES=8
# SCOPING_MIN_STUDIES=5
# MAX_RECORDS_TO_SCREEN=400
# RECENT_REVIEW_YEARS=4
# ACTIVE_TRIAL_COMPLETION_MONTHS=12
# CANDIDATE_TITLES_MIN=8
# CANDIDATE_TITLES_MAX=12
# LANDSCAPE_YEARS=10
# OUTPUT_DIR=output

# --- The update pipeline (docs/spec-update-pipeline.md) ---
# CANDIDATE_SOURCE=updates                  # or generated (the earlier pipeline)
# SKIP_REGISTRY_MIRRORS=false               # testing only: leave out the PROSPERO and OSF checks
# REVIEW_COUNT=50                           # step 3: reviews considered
# REVIEW_MIN_AGE_YEARS=3                    # step 3: published more than this long ago
# OVERLAP_RETRIEVAL_K=30                    # step 3: later records judged per review
# MAX_HITS=3000                             # step 5: more new records than this is too broad
# MIN_NEW_ELIGIBLE=6                        # step 5: marked when fewer ("more than 5")
# RUN_BUDGET_USD=50                         # step 5: pause before screening costs more
# SEARCH_RECALL_MIN=0.90  SCREEN_RECALL_MIN=0.95  MAX_SEARCH_REVISIONS=2   # step 7
# Step 3b and Step 5b, the agentic filters (prompts in src/guide_pipeline/prompts/)
# AGENT_PROMPTS_DIR=src/guide_pipeline/prompts
# TARGET_ELIGIBLE_MIN=10  TARGET_ELIGIBLE_MAX=60   # a feasible review's eligible studies
# MAX_CALLS_PER_CANDIDATE=8                 # Step 3b tool calls per candidate review
# MAX_CALLS_PER_OPTION=15                   # Step 5b tool calls per shortlisted option
# FULL_SCREEN_MAX=300  SAMPLE_SIZE=50       # Step 5b screening: all records, or a sample
# STAGE_BUDGET_USD=25                       # each stage stops when its spend passes this
# MINING_DB=data/mining.sqlite
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5    # local, downloaded once into MODELS_DIR
# VECTORS_DB=data/vectors.sqlite
# MODELS_DIR=data/models

# --- OSF registrations mirror (public API, no key needed) ---
# OSF_DB=data/osf.sqlite
# OSF_MIN_INTERVAL=1.0
# OSF_TOKEN=                                # free personal access token, only if rate limits bite
# MIRROR_STALENESS_DAYS=10

# --- PROSPERO mirror (local SQLite copy of the register) ---
# PROSPERO_DB=data/prospero.sqlite
# PROSPERO_MAX_AGE_DAYS=10
# PROSPERO_MIN_INTERVAL=3.0
# PROSPERO_REJECT_SIMILARITY=0.75
# PROSPERO_REVIEW_SIMILARITY=0.45

# --- The delivered guide (guide.docx, read-only, Symposed business plan style) ---
# GUIDE_PASSWORD=                           # locks the read-only protection; empty = readers can switch it off
# GUIDE_PDF=false                           # also save guide.pdf, made by Word from the same file
